{
  "info": {
    "_postman_id": "7c7e2d91-2d30-4d3c-9e3e-2b4b6b5c1a20",
    "name": "TaskBoard — TB-2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "boardId",
      "value": "1"
    },
    {
      "key": "taskId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Boards",
      "item": [
        {
          "name": "Lista tablic",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/boards"
          }
        },
        {
          "name": "Lista zadań tablicy — 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/boards/{{boardId}}/tasks"
          }
        },
        {
          "name": "Tablica nie istnieje — 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/boards/999999/tasks"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Szczegóły zadania — 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Zadanie nie istnieje — 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/999999"
          }
        },
        {
          "name": "Utwórz zadanie — 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nowe zadanie testowe\",\n  \"description\": \"Opis\",\n  \"status\": \"todo\",\n  \"priority\": \"medium\",\n  \"deadline\": \"2026-11-20\",\n  \"boardId\": 1,\n  \"assigneeId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Pusty tytuł — 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"  \",\n  \"boardId\": 1,\n  \"priority\": \"low\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Nieprawidłowy status — 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Błędny status\",\n  \"status\": \"waiting\",\n  \"priority\": \"low\",\n  \"boardId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Nieistniejąca tablica — 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Zła tablica\",\n  \"priority\": \"low\",\n  \"boardId\": 999999\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Zmień zadanie — 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Zmienione zadanie\",\n  \"description\": \"Zmieniony opis\",\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"deadline\": \"2026-11-21\",\n  \"boardId\": 1,\n  \"assigneeId\": 2\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Usuń zadanie miękko — 204",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Usuń nieistniejące zadanie — 404",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/999999"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Lista użytkowników — bez passwordHash",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          }
        }
      ]
    }
  ]
}

